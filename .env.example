# Duke AI Gateway key — generate at the Duke AI Dashboard with your NetID.
# On Hugging Face Spaces this is set as a Space secret, never committed.
DUKE_AI_GATEWAY_KEY=sk-your-key-here

# Optional overrides (defaults shown)
# MODEL_NAME=gpt-6-luna
# GATEWAY_BASE_URL=https://litellm.oit.duke.edu/v1
# RATE_LIMIT_PER_MIN=10
# DAILY_CAP=300
# MAX_INPUT_CHARS=1000
# LLM_EXTRA_BODY={"reasoning_effort": "low"}   # provider-specific params for reasoning models

# Optional fallback provider, tried when a Gateway call fails (any OpenAI-compatible API)
# FALLBACK_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
# FALLBACK_API_KEY=
# FALLBACK_MODEL=@cf/zai-org/glm-5.3-flash
# FALLBACK_EXTRA_BODY={"reasoning_effort": "low"}
# PRIMARY_COOLDOWN_S=600
