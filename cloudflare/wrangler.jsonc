// Live-demo deployment: runs the SAME Dockerfile the assignment grades,
// as a Cloudflare Container behind a tiny Worker.
{
  "name": "fixmyenglish",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Provider override while litellm.oit.duke.edu is unreachable off-campus (Sept 2026).
  // Remove these two vars (and the LLM_API_KEY secret) to return to the Duke Gateway.
  "vars": {
    "GATEWAY_BASE_URL": "https://api.cloudflare.com/client/v4/accounts/c16fa88f21cff530d60475dc28c00e7e/ai/v1",
    "MODEL_NAME": "@cf/zai-org/glm-5.3-flash",
    "LLM_EXTRA_BODY": "{\"reasoning_effort\": \"low\"}"
  },
  "containers": [
    {
      "class_name": "FixMyEnglishContainer",
      "image": "../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FIXMYENGLISH", "class_name": "FixMyEnglishContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FixMyEnglishContainer"] }
  ]
}
